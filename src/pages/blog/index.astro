---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/blog';

const posts = await getPosts();
---

<BaseLayout title="Blog · Affan Ali (muslimfrompk)" description="Security write-ups by Affan Ali (muslimfrompk): AI red teaming, bug bounty, and web/API security.">
	<main class="page">
		<p class="mono prompt">$ ls ~/blog</p>
		<h1>Blog</h1>
		<p class="lead">Write-ups on AI red teaming, bug bounty, and web/API security.</p>
		<PostList posts={posts} />
	</main>
</BaseLayout>
