---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, getPosts, readingTime } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, coverAlt, coverCaption, coverCaptionUrl, originalUrl } = post.data;
---

<BaseLayout title={`${title} · Affan Ali`} description={description}>
	<main class="page">
		<article>
			<header>
				<p class="meta mono">
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{updatedDate && <span>(updated {formatDate(updatedDate)})</span>}
					<span aria-hidden="true">·</span>
					<span>{readingTime(post)} min read</span>
				</p>
				<h1>{title}</h1>
				<TagList tags={tags} />
				{originalUrl && (
					<p class="note">
						Originally published on <a href={originalUrl} rel="noopener">Medium</a>. Migrated here
						with the original text and date.
					</p>
				)}
			</header>

			{cover && (
				<figure class="cover">
					<Image src={cover} alt={coverAlt} widths={[720, 1080, 1440]} sizes="(max-width: 46rem) 100vw, 44rem" loading="eager" />
					{coverCaption && (
						<figcaption>{coverCaptionUrl ? <a href={coverCaptionUrl} rel="noopener">{coverCaption}</a> : coverCaption}</figcaption>
					)}
				</figure>
			)}

			<div class="prose">
				<Content />
			</div>
		</article>
		<p class="back mono"><a href="/blog/">← all posts</a></p>
	</main>
</BaseLayout>

<style>
	.meta { margin: 0 0 0.5rem; color: var(--muted); font-size: 0.85rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
	h1 { font-size: clamp(1.6rem, 4.5vw, 2.2rem); line-height: 1.25; margin: 0 0 1rem; }
	.note {
		margin: 1.25rem 0 0;
		padding: 0.6rem 0.9rem;
		border-left: 3px solid var(--accent);
		background: var(--surface);
		color: var(--muted);
		font-size: 0.9rem;
	}
	.cover { margin: 2rem 0 0; }
	.cover :global(img) { width: 100%; height: auto; border-radius: 0.5rem; display: block; }
	figcaption { color: var(--muted); font-size: 0.8rem; margin-top: 0.4rem; text-align: center; }
	figcaption :global(a) { color: inherit; }
	.back { margin-top: 3rem; font-size: 0.9rem; }

	.prose { margin-top: 2rem; }
	.prose :global(h2) { font-size: 1.3rem; margin: 2.25rem 0 0.75rem; }
	.prose :global(h3) { font-size: 1.1rem; margin: 1.75rem 0 0.5rem; }
	.prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1rem; }
	.prose :global(li) { margin-bottom: 0.35rem; }
	.prose :global(img) { max-width: 100%; height: auto; border-radius: 0.4rem; border: 1px solid var(--border); display: block; margin: 0 auto; }
	/* `![alt](img)` followed by `*caption*` on the next line renders as one paragraph */
	.prose :global(p:has(> img)) { margin: 1.5rem 0; }
	.prose :global(p:has(> img) > em) { display: block; text-align: center; color: var(--muted); font-size: 0.85rem; margin-top: 0.4rem; }
	.prose :global(:not(pre) > code) { background: var(--surface); border: 1px solid var(--border); padding: 0.1em 0.35em; border-radius: 0.3rem; font-size: 0.9em; overflow-wrap: anywhere; }
	.prose :global(pre) { padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--border); overflow-x: auto; font-size: 0.875rem; line-height: 1.5; }
	.prose :global(blockquote) { margin: 1.5rem 0; padding: 0.25rem 1rem; border-left: 3px solid var(--accent); color: var(--muted); }
</style>
