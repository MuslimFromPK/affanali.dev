---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogArticle from '../../components/BlogArticle.astro';
import { getPosts } from '../../lib/blog';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description } = post.data;
---

<BaseLayout title={`${title} · Affan Ali`} description={description} ogType="article">
	<main class="page">
		<BlogArticle post={post} />
		<p class="back mono"><a href="/blog/">← all posts</a></p>
	</main>
</BaseLayout>

<style>
	.back { margin-top: 3rem; font-size: 0.9rem; }
</style>
