---
import site from '../data/site.json';
---

<footer class="site-footer mono">
	<ul>
		<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
		<li><a href={site.github} rel="me noopener">GitHub</a></li>
		<li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
		<li><a href={site.hackerone} rel="me noopener">HackerOne</a></li>
		<li><a href={site.patchstack} rel="me noopener">Patchstack</a></li>
	</ul>
	<span class="muted">{site.location}</span>
</footer>

<style>
	.site-footer {
		/* Same column as page content, so the rule lines up with the text */
		width: min(43.5rem, 100% - 2.5rem);
		margin: 0 auto;
		padding: 1.25rem 0 2.5rem;
		border-top: 1px solid var(--border);
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		font-size: 0.9rem;
	}
	ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
	.muted { color: var(--muted); }
</style>
